# HABÄNE Backend — environment template
# Copy to .env and fill in real values. Never commit .env.

# Supabase project
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
SUPABASE_PROJECT_ID=your-project-ref

# Client-side (build time, inlined into the browser bundle)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Stripe (server only) — optional; checkout/refunds answer 503 until set
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# Razorpay (server only) — optional; checkout/refunds answer 503 until set
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

# Slice (server only) — optional; checkout/refunds answer 503 until set
SLICE_API_KEY=xxxxxxxxxxxxxxxxxxxx
SLICE_API_SECRET=xxxxxxxxxxxxxxxxxxxx
SLICE_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

# DHL (server only) — optional; shipment creation falls back to manual entry until set
DHL_API_KEY=xxxxxxxxxxxxxxxxxxxx
DHL_API_SECRET=xxxxxxxxxxxxxxxxxxxx
DHL_ACCOUNT_NUMBER=xxxxxxxxxxxxxxxxxxxx

# Delhivery (server only) — optional; shipment creation falls back to manual entry until set
DELHIVERY_API_TOKEN=xxxxxxxxxxxxxxxxxxxx
DELHIVERY_CLIENT_NAME=xxxxxxxxxxxxxxxxxxxx

# Transactional email (Resend) — optional; emails are logged instead of sent until set
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=HABANE <noreply@example.com>
